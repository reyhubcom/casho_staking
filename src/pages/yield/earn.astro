        icon: 'tabler:external-link',
      },
    ]}
  >
    <Fragment slot="title">
      <script defer src="https://www.livecoinwatch.com/static/lcw-widget.js"></script> <div class="livecoinwatch-widget-5" lcw-base="USD" lcw-color-tx="#0693e3" lcw-marquee-1="coins" lcw-marquee-2="movers" lcw-marquee-items="30" ></div>
<script src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.7.1/dist/dotlottie-wc.js" type="module"></script>
<dotlottie-wc src="https://lottie.host/0ff0b07a-0a93-44aa-9c4f-c534b29c82fe/MHtxEEECle.lottie" speed="1" style="width: 100%; height: 400px" mode="forward" loop autoplay></dotlottie-wc>
    </Fragment>

    <Fragment slot="subtitle">
      Yields refer to the passive income generated from an investment over a specific period, typically expressed as an annual percentage rate. You can earn yields by leveraging different financial strategies, ranging from traditional savings to decentralized finance (DeFi) networks.
    </Fragment>
  </CallToAction>
  
      <span class="hidden sm:inline">
        <span class="font-semibold"></span> 
        </span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600"></span>
